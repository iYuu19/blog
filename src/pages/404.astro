---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getSiteSettings } from "../utils/site";

const notFound =
  (
    await getEntry("site-not-found", "not-found")
  )?.data ?? {
    pageTitle: "404",
    pageDescription: "你访问的页面不存在。",
    heroEyebrow: "404",
    heroTitle: "小白把路牌叼跑了",
    heroIntro: "这一页暂时还没回到春日部。你可以先回首页，或者去翻翻最近的题解档案。",
    primaryLinkLabel: "回到春日部",
    secondaryLinkLabel: "去看题解档案"
  };

const site = await getSiteSettings();
---

<Layout title={`${notFound.pageTitle} | ${site.siteTitle}`} description={notFound.pageDescription}>
  <section class="shell not-found-page">
    <div class="not-found-scene" aria-hidden="true">
      <div class="not-found-sun"></div>
      <div class="not-found-cloud not-found-cloud-a"></div>
      <div class="not-found-cloud not-found-cloud-b"></div>

      <div class="not-found-house">
        <span class="not-found-roof"></span>
        <span class="not-found-door"></span>
        <span class="not-found-window not-found-window-a"></span>
        <span class="not-found-window not-found-window-b"></span>
      </div>

      <div class="not-found-road">
        <span class="not-found-paw paw-a"></span>
        <span class="not-found-paw paw-b"></span>
        <span class="not-found-paw paw-c"></span>
        <span class="not-found-paw paw-d"></span>
      </div>

      <div class="not-found-sign">
        <strong>404</strong>
        <small>路牌不见了</small>
      </div>

      <div class="not-found-shiro">
        <svg viewBox="0 0 180 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="小白叼着路牌">
          <g>
            <ellipse cx="88" cy="110" rx="52" ry="30" fill="#fffdf7" stroke="#2c2840" stroke-width="4" />
            <circle cx="72" cy="78" r="34" fill="#fffdf7" stroke="#2c2840" stroke-width="4" />
            <ellipse cx="47" cy="54" rx="12" ry="18" fill="#fffdf7" stroke="#2c2840" stroke-width="4" transform="rotate(-18 47 54)" />
            <ellipse cx="96" cy="50" rx="12" ry="18" fill="#fffdf7" stroke="#2c2840" stroke-width="4" transform="rotate(16 96 50)" />
            <circle cx="62" cy="77" r="5.5" fill="#2c2840" />
            <circle cx="82" cy="77" r="5.5" fill="#2c2840" />
            <ellipse cx="72" cy="88" rx="6.5" ry="5.5" fill="#2c2840" />
            <path d="M60 97 Q72 108 85 97" fill="none" stroke="#2c2840" stroke-width="3.5" stroke-linecap="round" />
            <path d="M130 108 Q152 88 144 70" fill="none" stroke="#2c2840" stroke-width="5" stroke-linecap="round" />
            <rect x="32" y="22" width="84" height="28" rx="12" fill="#ffe79f" stroke="#2c2840" stroke-width="4" />
            <text x="74" y="41" text-anchor="middle" font-size="16" font-weight="700" fill="#cd3f2e">回家路牌</text>
            <path d="M95 85 L126 77" stroke="#2c2840" stroke-width="5" stroke-linecap="round" />
            <circle cx="121" cy="78" r="4" fill="#2c2840" />
            <ellipse cx="54" cy="138" rx="14" ry="8" fill="#fffdf7" stroke="#2c2840" stroke-width="4" />
            <ellipse cx="98" cy="138" rx="14" ry="8" fill="#fffdf7" stroke="#2c2840" stroke-width="4" />
          </g>
        </svg>
        <div class="not-found-sticker-card">
          <img
            class="not-found-shiro-image"
            src="/theme/stickers/shiro-complete.png"
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
        <img
          class="not-found-helper-sticker"
          src="/theme/stickers/shinchan-sign.png"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <div class="not-found-bubble">
          <span>汪？</span>
          <p>我只是把路牌先借走了。</p>
        </div>
      </div>
    </div>

    <div class="not-found-copy">
      <p class="eyebrow">{notFound.heroEyebrow}</p>
      <h1>{notFound.heroTitle}</h1>
      <p>{notFound.heroIntro}</p>

      <div class="not-found-note-row">
        <span>小白留下了脚印</span>
        <span>路牌暂存到档案箱</span>
        <span>春日部防卫队还在巡逻</span>
      </div>

      <div class="not-found-actions">
        <a class="not-found-btn not-found-btn-primary" href="/">
          <span aria-hidden="true">🏠</span>
          {notFound.primaryLinkLabel}
        </a>
        <a class="not-found-btn not-found-btn-secondary" href="/blog">
          <span aria-hidden="true">📁</span>
          {notFound.secondaryLinkLabel}
        </a>
      </div>

      <div class="not-found-mini-grid">
        <article>
          <strong>先回首页</strong>
          <p>重新从春日部事件档案首页进入。</p>
        </article>
        <article>
          <strong>看看最近题解</strong>
          <p>如果你本来就是来找题解，直接去归档页更快。</p>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found-page {
    display: grid;
    grid-template-columns: minmax(320px, 0.98fr) minmax(0, 1.02fr);
    gap: 34px;
    align-items: center;
    min-height: 72vh;
    padding: 40px 0 56px;
  }

  .not-found-scene,
  .not-found-copy {
    position: relative;
    min-width: 0;
  }

  .not-found-scene {
    min-height: 560px;
    border: 2px solid rgba(221, 180, 107, 0.65);
    border-radius: 38px 26px 34px 28px;
    background:
      radial-gradient(circle at 16% 14%, rgba(255, 210, 104, 0.42), transparent 18%),
      linear-gradient(180deg, rgba(202, 239, 255, 0.9), rgba(255, 247, 223, 0.98) 68%);
    box-shadow:
      0 24px 44px rgba(133, 97, 55, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.74);
    overflow: hidden;
  }

  .not-found-sun {
    position: absolute;
    top: 46px;
    left: 42px;
    width: 78px;
    height: 78px;
    border-radius: 999px;
    background: radial-gradient(circle at 35% 35%, #fff7c7, #ffd35e 68%);
    box-shadow: 0 0 0 12px rgba(255, 214, 112, 0.18);
  }

  .not-found-cloud {
    position: absolute;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow:
      28px 6px 0 0 rgba(255, 255, 255, 0.86),
      14px -10px 0 0 rgba(255, 255, 255, 0.82);
  }

  .not-found-cloud-a {
    top: 70px;
    right: 78px;
    width: 62px;
    height: 26px;
  }

  .not-found-cloud-b {
    top: 126px;
    left: 168px;
    width: 54px;
    height: 22px;
  }

  .not-found-house {
    position: absolute;
    left: 42px;
    bottom: 102px;
    width: 206px;
    height: 156px;
    border: 4px solid #2c2840;
    border-radius: 18px;
    background: linear-gradient(180deg, #fff8ea, #ffecc2);
  }

  .not-found-roof {
    position: absolute;
    left: -10px;
    top: -42px;
    width: 222px;
    height: 58px;
    border: 4px solid #2c2840;
    border-bottom: 0;
    border-radius: 22px 22px 0 0;
    background: #e85c4a;
    transform: skewX(-14deg);
  }

  .not-found-door,
  .not-found-window {
    position: absolute;
    border: 4px solid #2c2840;
    border-radius: 14px;
    background: #bfe7fb;
  }

  .not-found-door {
    left: 84px;
    bottom: 0;
    width: 54px;
    height: 78px;
    background: #ffe79f;
  }

  .not-found-window-a {
    left: 22px;
    top: 30px;
    width: 48px;
    height: 42px;
  }

  .not-found-window-b {
    right: 22px;
    top: 30px;
    width: 48px;
    height: 42px;
  }

  .not-found-road {
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: -32px;
    height: 150px;
    border-top: 4px solid rgba(44, 40, 64, 0.16);
    border-radius: 48% 52% 0 0;
    background: linear-gradient(180deg, #f3c48b, #eab16a);
  }

  .not-found-paw {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: rgba(44, 40, 64, 0.16);
  }

  .not-found-paw::before,
  .not-found-paw::after {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(44, 40, 64, 0.16);
  }

  .not-found-paw::before {
    top: -8px;
    left: 0;
    box-shadow: 10px -1px 0 rgba(44, 40, 64, 0.16);
  }

  .not-found-paw::after {
    top: -5px;
    right: -8px;
  }

  .paw-a { left: 50%; top: 34px; transform: rotate(-18deg); }
  .paw-b { left: 58%; top: 52px; transform: rotate(12deg); }
  .paw-c { left: 67%; top: 72px; transform: rotate(-8deg); }
  .paw-d { left: 76%; top: 92px; transform: rotate(10deg); }

  .not-found-sign {
    position: absolute;
    right: 84px;
    top: 124px;
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    border: 4px solid #2c2840;
    border-radius: 24px;
    background: linear-gradient(180deg, #fff8de, #ffd97d);
    box-shadow: 0 14px 24px rgba(133, 97, 55, 0.14);
    transform: rotate(8deg);
  }

  .not-found-sign::after {
    content: "";
    position: absolute;
    bottom: -62px;
    width: 10px;
    height: 62px;
    border-radius: 999px;
    background: #8d7767;
  }

  .not-found-sign strong {
    font-size: 34px;
    color: #cd3f2e;
    line-height: 1;
  }

  .not-found-sign small {
    color: #7f6452;
    font-size: 13px;
    font-weight: 700;
  }

  .not-found-shiro {
    position: absolute;
    right: 30px;
    bottom: 42px;
    width: min(288px, 56%);
  }

  .not-found-shiro svg {
    display: none;
  }

  .not-found-sticker-card {
    position: relative;
    padding: 18px 18px 14px;
    border: 2px solid rgba(221, 180, 107, 0.58);
    border-radius: 28px 24px 30px 22px;
    background:
      radial-gradient(circle at top left, rgba(255, 228, 155, 0.24), transparent 24%),
      linear-gradient(180deg, rgba(255, 254, 250, 0.98), rgba(255, 247, 232, 0.94));
    box-shadow:
      0 18px 34px rgba(133, 97, 55, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.82);
    transform: rotate(-3.5deg);
  }

  .not-found-shiro-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 16px 24px rgba(133, 97, 55, 0.18));
  }

  .not-found-helper-sticker {
    position: absolute;
    right: -18px;
    bottom: -16px;
    width: clamp(110px, 34%, 146px);
    height: auto;
    transform: rotate(10deg);
    filter: drop-shadow(0 16px 22px rgba(90, 64, 40, 0.16));
  }

  .not-found-bubble {
    position: absolute;
    left: -34px;
    top: 8px;
    max-width: 170px;
    padding: 12px 14px;
    border: 2px solid rgba(221, 180, 107, 0.74);
    border-radius: 18px 18px 18px 10px;
    background: rgba(255, 252, 244, 0.96);
    box-shadow: 0 10px 18px rgba(133, 97, 55, 0.08);
  }

  .not-found-bubble::after {
    content: "";
    position: absolute;
    left: 18px;
    bottom: -10px;
    width: 16px;
    height: 16px;
    border-right: 2px solid rgba(221, 180, 107, 0.74);
    border-bottom: 2px solid rgba(221, 180, 107, 0.74);
    background: rgba(255, 252, 244, 0.96);
    transform: rotate(36deg);
  }

  .not-found-bubble span {
    display: inline-flex;
    min-height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(232, 92, 74, 0.12);
    color: #cd3f2e;
    font-size: 12px;
    font-weight: 700;
  }

  .not-found-bubble p {
    margin: 8px 0 0;
    color: #4f4b63;
    font-size: 14px;
    line-height: 1.5;
  }

  .not-found-copy {
    display: grid;
    gap: 18px;
    align-content: center;
  }

  .not-found-copy h1 {
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.08;
  }

  .not-found-copy > p:last-of-type {
    max-width: 40rem;
    color: var(--soft-text);
    font-size: 17px;
  }

  .not-found-note-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .not-found-note-row span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 2px solid rgba(221, 180, 107, 0.58);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: #7f6452;
    box-shadow: 0 10px 18px rgba(133, 97, 55, 0.06);
  }

  .not-found-note-row span:nth-child(3n + 1) {
    background: linear-gradient(180deg, rgba(255, 242, 194, 0.98), rgba(255, 232, 159, 0.94));
  }

  .not-found-note-row span:nth-child(3n + 2) {
    background: linear-gradient(180deg, rgba(232, 247, 255, 0.98), rgba(198, 233, 251, 0.94));
  }

  .not-found-note-row span:nth-child(3n) {
    background: linear-gradient(180deg, rgba(255, 232, 224, 0.98), rgba(255, 207, 188, 0.94));
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 48px;
    padding: 0 20px;
    border: 2px solid rgba(221, 180, 107, 0.68);
    border-radius: 999px;
    color: var(--accent-strong);
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 12px 22px rgba(133, 97, 55, 0.1);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .not-found-btn:hover {
    transform: translateY(-2px) rotate(-0.35deg);
    box-shadow: 0 18px 28px rgba(133, 97, 55, 0.14);
  }

  .not-found-btn-primary {
    background: linear-gradient(180deg, rgba(255, 242, 194, 0.98), rgba(255, 232, 159, 0.94));
  }

  .not-found-btn-secondary {
    background: linear-gradient(180deg, rgba(232, 247, 255, 0.98), rgba(198, 233, 251, 0.94));
  }

  .not-found-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 6px;
  }

  .not-found-mini-grid article {
    padding: 18px 18px 16px;
    border: 2px solid rgba(221, 180, 107, 0.56);
    border-radius: 24px 18px 22px 26px;
    background: linear-gradient(180deg, rgba(255, 251, 242, 0.98), rgba(255, 245, 226, 0.92));
    box-shadow: 0 14px 24px rgba(133, 97, 55, 0.06);
  }

  .not-found-mini-grid strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 16px;
  }

  .not-found-mini-grid p {
    margin: 0;
    color: var(--soft-text);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 920px) {
    .not-found-page {
      grid-template-columns: 1fr;
      padding-top: 28px;
    }

    .not-found-scene {
      min-height: 500px;
    }
  }

  @media (max-width: 640px) {
    .not-found-scene {
      min-height: 420px;
    }

    .not-found-sign {
      right: 38px;
      top: 104px;
      width: 112px;
      height: 112px;
    }

    .not-found-house {
      left: 18px;
      width: 154px;
      height: 122px;
    }

    .not-found-roof {
      width: 168px;
    }

    .not-found-shiro {
      right: 10px;
      bottom: 28px;
      width: 210px;
    }

    .not-found-bubble {
      left: -8px;
      top: -6px;
      max-width: 132px;
    }

    .not-found-copy h1 {
      font-size: 32px;
    }

    .not-found-mini-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
