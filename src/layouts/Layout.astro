---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteSettings } from "../utils/site";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  socialImage?: string;
}

const {
  title,
  description,
  socialImage
} = Astro.props;
const site = await getSiteSettings();
const metaDescription = description ?? site.siteDescription;
const canonicalUrl = Astro.url.href;
const resolvedSocialImage = new URL(
  socialImage || site.defaultSocialImage || site.avatarImage || "/avatar.jpg",
  Astro.url
).toString();
const faviconHref = site.faviconPath || "/favicon.svg";
const isHomePage = Astro.url.pathname === "/";
const isContestsIndexPage = Astro.url.pathname === "/contests/" || Astro.url.pathname === "/contests";
const isArchiveIndexPage = Astro.url.pathname === "/blog/" || Astro.url.pathname === "/blog";
const isAboutPage = Astro.url.pathname === "/about/" || Astro.url.pathname === "/about";
const isSearchPage = Astro.url.pathname === "/search/" || Astro.url.pathname === "/search";
const bodyClass = [
  "theme-shinchan",
  isHomePage ? "page-home" : "",
  isContestsIndexPage ? "page-contests-index" : "",
  isArchiveIndexPage ? "page-archive-index" : "",
  isAboutPage ? "page-about" : "",
  isSearchPage ? "page-search" : ""
]
  .filter(Boolean)
  .join(" ");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f4f1eb" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta property="og:site_name" content={site.siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <ViewTransitions />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <title>{title}</title>
  </head>
  <body class={bodyClass} data-home-page={isHomePage ? "true" : "false"}>
    <div class="page-progress" aria-hidden="true"></div>
<button class="shinchan-radio" aria-label="播放或暂停欢迎语音" id="shinchan-radio" type="button">
      <span class="shinchan-radio-disc" aria-hidden="true"></span>
      <span class="shinchan-radio-text">
        <strong>iYuu Radio</strong>
        <small>欢迎你回家</small>
      </span>
    </button>
    <!-- 灏忔柊璧拌矾 - 椤甸潰搴曢儴 -->
    <div class="shinchan-walker" aria-hidden="true" id="shinchan-walker">
      <img
        class="character-sticker walker-sticker"
        src="/theme/stickers/shinchan-walker.png"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- 灏忕櫧鎺㈠ご - 鍙充笅瑙?-->
    <div class="shiro-corner" aria-hidden="true" id="shiro-corner">
      <img
        class="character-sticker shiro-sticker"
        src="/theme/stickers/shiro-complete.png"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- 鍔ㄦ劅瓒呬汉 - 鍋跺皵椋炶繃 -->
    <div class="action-flyer" aria-hidden="true" id="action-flyer">
      <img
        class="character-sticker action-sticker"
        src="/theme/stickers/shinchan-sign.png"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const siteState = window.__iyuuSiteState ??= {
        lifecycleBound: false,
        pageCleanup: undefined,
        persistentReady: false,
        themeReady: false
      };

      const cleanupPageEnhancements = () => {
        if (typeof siteState.pageCleanup === "function") {
          try {
            siteState.pageCleanup();
          } catch (error) {
            // Ignore cleanup failures so the next init still runs.
          }
        }

        siteState.pageCleanup = undefined;
      };

      const applyThemePreference = (isDark) => {
        document.documentElement.classList.toggle("is-dark-mode", isDark);
        document.getElementById("theme-toggle")?.classList.toggle("is-dark", isDark);

        try {
          window.localStorage.setItem("theme-preference", isDark ? "dark" : "light");
        } catch (error) {
          // Ignore storage failures.
        }
      };

      const syncThemeToggle = () => {
        document
          .getElementById("theme-toggle")
          ?.classList.toggle("is-dark", document.documentElement.classList.contains("is-dark-mode"));
      };

      const initThemePreference = () => {
        if (siteState.themeReady) {
          syncThemeToggle();
          return;
        }

        siteState.themeReady = true;

        let savedTheme = null;
        try {
          savedTheme = window.localStorage.getItem("theme-preference");
        } catch (error) {
          savedTheme = null;
        }

        if (savedTheme === "dark") {
          applyThemePreference(true);
        } else if (savedTheme === "light") {
          applyThemePreference(false);
        } else {
          document.documentElement.classList.toggle(
            "is-dark-mode",
            window.matchMedia("(prefers-color-scheme: dark)").matches
          );
          syncThemeToggle();
        }

        const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: dark)");
        colorSchemeQuery.addEventListener("change", (event) => {
          let storedTheme = null;

          try {
            storedTheme = window.localStorage.getItem("theme-preference");
          } catch (error) {
            storedTheme = null;
          }

          if (!storedTheme) {
            document.documentElement.classList.toggle("is-dark-mode", event.matches);
            syncThemeToggle();
          }
        });
      };

      const initPersistentEnhancements = () => {
        if (siteState.persistentReady) {
          syncThemeToggle();
          return;
        }

        siteState.persistentReady = true;
        initThemePreference();

        const burstStickers = [
          { text: "CTF", tone: "red" },
          { text: "WP", tone: "blue" },
          { text: "BLOG", tone: "gold" },
          { text: "TAG", tone: "mint" },
          { text: "NEW", tone: "peach" },
          { text: "GO", tone: "sky" }
        ];

        const spawnClickBurst = (x, y) => {
          const burst = document.createElement("span");
          burst.className = "click-burst";
          burst.style.left = `${x}px`;
          burst.style.top = `${y}px`;
          const count = 6 + Math.floor(Math.random() * 4);

          for (let index = 0; index < count; index += 1) {
            const angle = (Math.PI * 2 * index) / count + Math.random() * 0.5;
            const distance = 34 + Math.random() * 42;
            const token = burstStickers[Math.floor(Math.random() * burstStickers.length)];
            const span = document.createElement("span");

            span.textContent = token.text;
            span.dataset.tone = token.tone;
            span.style.setProperty("--burst-x", `${Math.cos(angle) * distance}px`);
            span.style.setProperty("--burst-y", `${Math.sin(angle) * distance}px`);
            span.style.setProperty("--burst-rotate", `${Math.random() * 60 - 30}deg`);
            burst.appendChild(span);
          }

          document.body.appendChild(burst);
          window.setTimeout(() => burst.remove(), 820);
        };

        document.addEventListener(
          "click",
          (event) => {
            const target = event.target;

            if (!(target instanceof Element)) {
              return;
            }

            const themeToggle = target.closest("#theme-toggle");
            if (themeToggle) {
              event.preventDefault();
              applyThemePreference(!document.documentElement.classList.contains("is-dark-mode"));
              return;
            }

            const radio = target.closest("#shinchan-radio");
            if (radio) {
              radio.classList.toggle("is-paused");
              const small = radio.querySelector(".shinchan-radio-text small");
              if (small) {
                small.textContent = radio.classList.contains("is-paused")
                  ? "欢迎语音已暂停"
                  : "欢迎你回家";
              }
              return;
            }

            spawnClickBurst(event.clientX, event.clientY);
          },
          { passive: false }
        );

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (prefersReducedMotion) {
          return;
        }

        const walker = document.getElementById("shinchan-walker");
        const shiro = document.getElementById("shiro-corner");
        const actionFlyer = document.getElementById("action-flyer");

        if (walker) {
          let walkerVisible = false;

          const triggerWalker = () => {
            if (walkerVisible) {
              return;
            }

            walkerVisible = true;
            const direction = Math.random() > 0.5 ? 1 : -1;
            const startX = direction === 1 ? -120 : window.innerWidth + 120;
            const endX = direction === 1 ? window.innerWidth + 120 : -120;

            walker.style.transform = `scaleX(${direction})`;
            walker.style.left = `${startX}px`;
            walker.classList.add("is-walking");

            const duration = 12000 + Math.random() * 8000;
            const startTime = performance.now();

            const animateWalker = (now) => {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const currentX = startX + (endX - startX) * progress;
              const bounce = Math.sin(elapsed / 180) * 3;

              walker.style.left = `${currentX}px`;
              walker.style.bottom = `${16 + bounce}px`;

              if (progress < 1) {
                requestAnimationFrame(animateWalker);
                return;
              }

              walker.classList.remove("is-walking");
              walkerVisible = false;
              window.setTimeout(triggerWalker, 8000 + Math.random() * 20000);
            };

            requestAnimationFrame(animateWalker);
          };

          window.setTimeout(triggerWalker, 3000 + Math.random() * 5000);
        }

        if (shiro) {
          let shiroPeeking = false;
          let scrollCount = 0;

          const triggerShiroPeek = () => {
            if (shiroPeeking) {
              return;
            }

            shiroPeeking = true;
            shiro.classList.add("is-peeking");
            window.setTimeout(() => {
              shiro.classList.remove("is-peeking");
              shiroPeeking = false;
            }, 3000 + Math.random() * 2000);
          };

          window.addEventListener(
            "scroll",
            () => {
              scrollCount += 1;
              if (scrollCount % 12 === 0 && Math.random() > 0.6) {
                triggerShiroPeek();
              }
            },
            { passive: true }
          );

          window.setInterval(() => {
            if (Math.random() > 0.65) {
              triggerShiroPeek();
            }
          }, 15000);
        }

        if (actionFlyer) {
          const triggerActionFly = () => {
            const direction = Math.random() > 0.5 ? 1 : -1;
            const startY = 80 + Math.random() * (window.innerHeight * 0.4);
            const startX = direction === 1 ? -160 : window.innerWidth + 160;
            const endX = direction === 1 ? window.innerWidth + 160 : -160;
            const duration = 2500 + Math.random() * 1500;
            const startTime = performance.now();

            actionFlyer.style.top = `${startY}px`;
            actionFlyer.style.left = `${startX}px`;
            actionFlyer.style.transform = `scaleX(${direction})`;
            actionFlyer.classList.add("is-flying");

            const animateFly = (now) => {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 2);
              const currentX = startX + (endX - startX) * eased;
              const wobble = Math.sin(elapsed / 200) * 8;

              actionFlyer.style.left = `${currentX}px`;
              actionFlyer.style.top = `${startY + wobble}px`;

              if (progress < 1) {
                requestAnimationFrame(animateFly);
                return;
              }

              actionFlyer.classList.remove("is-flying");
            };

            requestAnimationFrame(animateFly);
          };

          const scheduleActionFly = () => {
            window.setTimeout(() => {
              triggerActionFly();
              scheduleActionFly();
            }, 20000 + Math.random() * 40000);
          };

          window.setTimeout(scheduleActionFly, 10000 + Math.random() * 10000);
        }
      };

      const initPageEnhancements = () => {
        cleanupPageEnhancements();
        syncThemeToggle();

        const cleanups = [];
        const registerCleanup = (cleanup) => {
          cleanups.push(cleanup);
        };
        const registerEvent = (target, eventName, listener, options) => {
          target.addEventListener(eventName, listener, options);
          registerCleanup(() => target.removeEventListener(eventName, listener, options));
        };
        const registerTimeout = (callback, delay) => {
          const timeoutId = window.setTimeout(callback, delay);
          registerCleanup(() => window.clearTimeout(timeoutId));
          return timeoutId;
        };
        const registerInterval = (callback, delay) => {
          const intervalId = window.setInterval(callback, delay);
          registerCleanup(() => window.clearInterval(intervalId));
          return intervalId;
        };

        const root = document.documentElement;
        const body = document.body;
        const isHomePage = body?.dataset.homePage === "true";
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const motionPointer = window.matchMedia("(pointer: fine)").matches;

        const updateScrollProgress = () => {
          const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
          root.style.setProperty("--scroll-progress", progress.toFixed(4));
        };

        updateScrollProgress();
        registerEvent(window, "scroll", updateScrollProgress, { passive: true });
        registerEvent(window, "resize", updateScrollProgress);

        const initWelcomeVoice = () => {
          if (!isHomePage) {
            return;
          }

          const sessionKey = "iyuu-home-welcome-played";

          try {
            if (window.sessionStorage.getItem(sessionKey) === "1") {
              return;
            }
          } catch (error) {
            // Ignore storage failures and continue with a best-effort greeting.
          }

          try {
            const welcomeAudio = new Audio("/theme/audio/welcome-home.mp3");
            welcomeAudio.preload = "auto";
            welcomeAudio.volume = 0.96;
            welcomeAudio.load();

            let hasPlayed = false;
            const fallbackEvents = [
              ["wheel", { passive: true }],
              ["touchmove", { passive: true }],
              ["touchstart", { passive: true }],
              ["pointerdown", { passive: true }],
              ["keydown", false]
            ];

            const cleanupFallbackEvents = () => {
              fallbackEvents.forEach(([eventName, options]) => {
                window.removeEventListener(eventName, playWelcomeLine, options);
              });
            };

            const markPlayed = () => {
              if (hasPlayed) {
                return;
              }

              hasPlayed = true;

              try {
                window.sessionStorage.setItem(sessionKey, "1");
              } catch (error) {
                // Ignore storage failures.
              }

              cleanupFallbackEvents();
            };

            const playWelcomeLine = () => {
              if (hasPlayed) {
                return;
              }

              try {
                welcomeAudio.currentTime = 0;
                const playback = welcomeAudio.play();

                if (playback && typeof playback.then === "function") {
                  playback.then(markPlayed).catch(() => {
                    // Wait for a user gesture and try again.
                  });
                } else {
                  markPlayed();
                }
              } catch (error) {
                // Ignore playback failures and wait for the next gesture.
              }
            };

            welcomeAudio.addEventListener("play", markPlayed, { once: true });
            registerCleanup(() => {
              cleanupFallbackEvents();
              try {
                welcomeAudio.pause();
              } catch (error) {
                // Ignore audio cleanup failures.
              }
            });

            registerTimeout(playWelcomeLine, 320);
            fallbackEvents.forEach(([eventName, options]) => {
              registerEvent(window, eventName, playWelcomeLine, options);
            });
          } catch (error) {
            // Ignore welcome voice failures so content rendering still works.
          }
        };

        const heroCard = document.querySelector(".hero-card-illustrated");
        if (heroCard && !prefersReducedMotion && motionPointer) {
          const handleHeroPointerMove = (event) => {
            const rect = heroCard.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
            const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

            heroCard.style.setProperty("--hero-x", x.toFixed(3));
            heroCard.style.setProperty("--hero-y", y.toFixed(3));
          };

          const resetHeroPointer = () => {
            heroCard.style.setProperty("--hero-x", "0");
            heroCard.style.setProperty("--hero-y", "0");
          };

          registerEvent(heroCard, "pointermove", handleHeroPointerMove);
          registerEvent(heroCard, "pointerleave", resetHeroPointer);
        }

        const playfulCards = Array.from(
          document.querySelectorAll(
            ".hero-note-card, .overview-panel, .shinchan-cast-card, .signal-card, .route-card, .track-board, .tag-board, .featured-card, .rich-section-card, .guide-card, .guestbook-card, .guestbook-note-panel"
          )
        );

        if (!prefersReducedMotion && motionPointer) {
          playfulCards.forEach((card) => {
            const handleCardPointerMove = (event) => {
              const rect = card.getBoundingClientRect();
              const x = ((event.clientX - rect.left) / rect.width) * 100;
              const y = ((event.clientY - rect.top) / rect.height) * 100;

              card.style.setProperty("--spot-x", `${x.toFixed(1)}%`);
              card.style.setProperty("--spot-y", `${y.toFixed(1)}%`);
            };

            registerEvent(card, "pointermove", handleCardPointerMove);
          });
        }

        const magneticTargets = Array.from(
          document.querySelectorAll(
            ".nav-link, .footer-link-pill, .hero-links-strong a, .overview-links a, .shinchan-cast-link, .section-link"
          )
        );

        if (!prefersReducedMotion && motionPointer) {
          magneticTargets.forEach((target) => {
            const handleMouseMove = (event) => {
              const rect = target.getBoundingClientRect();
              const x = event.clientX - rect.left - rect.width / 2;
              const y = event.clientY - rect.top - rect.height / 2;

              target.style.transform = `translate(${x * 0.12}px, ${y * 0.12}px)`;
            };

            const resetTransform = () => {
              target.style.transform = "";
            };

            registerEvent(target, "mousemove", handleMouseMove);
            registerEvent(target, "mouseleave", resetTransform);
          });
        }

        const revealTargets = Array.from(
          document.querySelectorAll(
            ".hero-card, .home-overview, .overview-panel, .shinchan-speech, .shinchan-showcase, .shinchan-cast-card, .section, .section-block, .about-overview-grid, .about-summary-grid, .guide-card, .route-card, .signal-card, .track-board, .tag-board, .rich-section-card, .featured-card, .guestbook-card, .guestbook-note-panel"
          )
        );

        const showRevealTargets = () => {
          revealTargets.forEach((element) => element.classList.add("is-visible"));
        };

        const initRevealTargets = () => {
          if (revealTargets.length === 0) {
            return;
          }

          if (prefersReducedMotion || !("IntersectionObserver" in window)) {
            showRevealTargets();
            return;
          }

          try {
            revealTargets.forEach((element, index) => {
              element.style.setProperty("--reveal-delay", `${Math.min(index * 28, 220)}ms`);
            });

            const revealObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting) {
                    return;
                  }

                  entry.target.classList.add("is-visible");
                  revealObserver.unobserve(entry.target);
                });
              },
              {
                threshold: 0.14,
                rootMargin: "0px 0px -48px 0px"
              }
            );

            revealTargets.forEach((element) => revealObserver.observe(element));
            registerCleanup(() => revealObserver.disconnect());

            registerTimeout(() => {
              revealTargets.forEach((element) => {
                const rect = element.getBoundingClientRect();
                if (rect.top < window.innerHeight * 1.1) {
                  element.classList.add("is-visible");
                }
              });
            }, 180);

            registerTimeout(showRevealTargets, 1400);
          } catch (error) {
            showRevealTargets();
          }
        };

        const initGuestbookClock = () => {
          const dateNodes = Array.from(document.querySelectorAll("[data-guestbook-live-date]"));
          const timeNodes = Array.from(document.querySelectorAll("[data-guestbook-live-time]"));

          if (dateNodes.length === 0 && timeNodes.length === 0) {
            return;
          }

          const pad = (value) => String(value).padStart(2, "0");
          const updateGuestbookClock = () => {
            const now = new Date();
            const dateText = `${now.getFullYear()}.${pad(now.getMonth() + 1)}.${pad(now.getDate())}`;
            const timeText = `${pad(now.getHours())}:${pad(now.getMinutes())}`;

            dateNodes.forEach((node) => {
              node.textContent = dateText;
            });

            timeNodes.forEach((node) => {
              node.textContent = timeText;
            });
          };

          updateGuestbookClock();
          registerInterval(updateGuestbookClock, 15000);
        };

        initRevealTargets();
        initGuestbookClock();

        try {
          initWelcomeVoice();
        } catch (error) {
          // Ignore welcome voice failures so content rendering still works.
        }

        siteState.pageCleanup = () => {
          while (cleanups.length > 0) {
            const cleanup = cleanups.pop();
            try {
              cleanup?.();
            } catch (error) {
              // Ignore cleanup failures.
            }
          }
        };
      };

      initPersistentEnhancements();
      initPageEnhancements();

      if (!siteState.lifecycleBound) {
        siteState.lifecycleBound = true;
        document.addEventListener("astro:page-load", initPageEnhancements);
        window.addEventListener("pageshow", (event) => {
          if (event.persisted) {
            initPageEnhancements();
          }
        });
      }

      const initPageViewTracking = () => {
        const endpoint = "/api/track";
        const storageKey = "iyuu-anonymous-visitor";
        const ignoreStorageKey = "iyuu-analytics-ignore";

        const getVisitorId = () => {
          try {
            let visitorId = window.localStorage.getItem(storageKey);
            if (!visitorId) {
              visitorId = crypto.randomUUID();
              window.localStorage.setItem(storageKey, visitorId);
            }
            return visitorId;
          } catch (error) {
            return "";
          }
        };

        const shouldIgnoreTracking = () => {
          try {
            return window.localStorage.getItem(ignoreStorageKey) === "true";
          } catch (error) {
            return false;
          }
        };

        const trackPageView = () => {
          if (location.pathname.startsWith("/admin") || location.pathname.startsWith("/api/")) {
            return;
          }

          if (shouldIgnoreTracking()) {
            return;
          }

          const payload = JSON.stringify({
            path: location.pathname,
            title: document.title,
            referrer: document.referrer,
            visitorId: getVisitorId()
          });

          try {
            if (navigator.sendBeacon) {
              const body = new Blob([payload], { type: "application/json" });
              navigator.sendBeacon(endpoint, body);
              return;
            }
          } catch (error) {
            // Fall back to fetch below.
          }

          fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: payload,
            keepalive: true
          }).catch(() => {});
        };

        trackPageView();
        document.addEventListener("astro:page-load", trackPageView);
      };

      if (!siteState.analyticsReady) {
        siteState.analyticsReady = true;
        initPageViewTracking();
      }
    </script>
  </body>
</html>
